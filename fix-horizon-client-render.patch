+/// Leaf culling: how the mesher thins out leaf faces (see `mesher/leaf_culling.rs`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum LeafCullingMode {
+    /// Every leaf face is drawn as vanilla does.
+    #[default]
+    Off,
+    /// Fully enclosed leaves are solidified into the opaque layer.
+    Solid,
+    /// Also solidifies leaves with a single open face, thinning the canopy shell.
+    SolidAggressive,
+    /// Drops faces shared between two leaves inside the section.
+    Hollow,
+}
+impl LeafCullingMode {
+    /// Whether the mode needs the section's leaf mask (`Solid`, `SolidAggressive`).
+    pub fn is_interior(self) -> bool {
+        matches!(self, LeafCullingMode::Solid | LeafCullingMode::SolidAggressive)
+    }
+}
