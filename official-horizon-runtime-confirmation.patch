+function requestOfficialRuntimeInstall(url,followLatest,label){
+ const address=String(url||'');
+ const valid=/^https:\/\/github\.com\/horizon-rust\/horizon\/releases\/download\/[^/?#]+\/[^/?#]+\.hruntime\.zip$/.test(address);
+ if(!valid){toast('This release has no compatible Android runtime package. Desktop ZIP/TAR files cannot run on Android.');return false;}
+ if(!window.HorizonAndroid||typeof window.HorizonAndroid.downloadRuntime!=='function'){toast('Open Horizon Android + to install runtime packages.');return false;}
+ if(state.modal)return false;
+ const name=String(label||'Official Horizon release');
+ state.pendingOfficialRuntimeInstall={url:address,followLatest:!!followLatest,label:name};
+ const behavior=followLatest?'After installation, Instances set to follow latest will use this build.':'This release will be added side-by-side and can be selected from Instances.';
+ openModal(
+  'Continue with installation?',
+  `Install ${escapeHtml(name)} in Horizon Android +?`,
+  `<div class="notice"><strong>${escapeHtml(name)}</strong><br>This downloads an Android runtime from the official Horizon release and installs it inside Horizon Android +.</div><div class="notice">The package must match this device's Android ABI and Minecraft engine version. Android Plus checks the ELF architecture and SHA-256 before installing. Desktop ZIP/TAR archives are not accepted.</div><p class="muted">${behavior}</p>`,
+  '<button class="btn" data-action="cancel-official-runtime-install">Not now</button><button class="btn primary" data-action="confirm-official-runtime-install">Continue</button>'
+ );
+ return true;
+}
